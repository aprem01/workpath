generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Auth models (NextAuth)
// =====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// User & Profile
// =====================

model User {
  id              String        @id @default(cuid())
  email           String?       @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  anonymousHandle String?       @unique  // e.g. "SkillPro_4829"
  zipCode         String?
  workAuthStatus  String?       // "authorized" | "need_sponsorship" | "prefer_not_to_say"
  veteranStatus   String?       // "veteran" | "not_veteran" | "prefer_not_to_say"
  disabilityAccom String?       // "yes" | "no" | "prefer_not_to_say"
  profileComplete Boolean       @default(false)
  // Caroline 8/23 Round 8: hashed password, never plaintext. Format:
  //   "scrypt:<saltHex>:<hashHex>"
  // Null when the account was created before password hashing landed.
  passwordHash    String?
  // Round 8 profile-verification requirement: fully-completed profiles
  // (first name, last name, phone, work auth) are the gate for
  // accepting interview requests and revealing PII to employers.
  firstName       String?
  lastName        String?
  phone           String?
  createdAt       DateTime      @default(now())
  skills          UserSkill[]
  applications    Application[]
  sessions        Session[]
  accounts        Account[]
}

model UserSkill {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawInput        String
  normalizedTerm  String
  category        String
  proficiencyLevel String
  isAISuggested   Boolean  @default(false)
  skillNodeId     String?
  skillNode       SkillNode? @relation(fields: [skillNodeId], references: [id])
  addedAt         DateTime @default(now())
}

// =====================
// Skill Graph Taxonomy (3-layer)
// =====================

model SkillNode {
  id                String      @id @default(cuid())
  canonicalTerm     String      @unique
  vertical          String?     // "home_health_aide", "tech", "trades", null=universal
  layer             String      // "canonical" | "parent" | "micro"
  aiResistanceScore Int         @default(50)

  aliases           SkillAlias[]
  userSkills        UserSkill[]

  parentId          String?
  parent            SkillNode?  @relation("SkillHierarchy", fields: [parentId], references: [id])
  children          SkillNode[] @relation("SkillHierarchy")

  createdAt         DateTime    @default(now())
}

model SkillAlias {
  id          String    @id @default(cuid())
  rawTerm     String    @unique
  skillNodeId String
  skillNode   SkillNode @relation(fields: [skillNodeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

// Deterministic normalization cache.
//
// The AI normalizer returned a different canonical term for the same word
// on different runs: "cooking" produced five ("Meal Preparation", "Food
// Preparation and Cooking", ...) and "customer service" produced three
// that differed only by capitalisation. Every variant splits the matching
// pool, so the layer we call canonical was not canonical.
//
// The first resolution of a given input wins and is reused forever. That
// makes matching reproducible and testable (Caroline 8/11) and removes a
// model call from the hot path.
//
// Keyed on the lowercased input plus the industry the user picked, so a
// deliberate "Meal Preparation (Food Service)" stays distinct from
// "Meal Preparation (Healthcare Support)" while accidental drift cannot
// happen.
model SkillNormalization {
  id             String   @id @default(cuid())
  rawInput       String
  domainId       String   @default("")
  normalizedTerm String
  // Full response body, so a cache hit returns exactly what a miss would.
  payload        String
  // Bumped when safety rules change so previously-allowed terms are
  // re-screened instead of being grandfathered in by the cache.
  safetyVersion  Int      @default(1)
  hitCount       Int      @default(0)
  createdAt      DateTime @default(now())
  lastUsedAt     DateTime @default(now())

  @@unique([rawInput, domainId])
  @@index([normalizedTerm])
}

// =====================
// Jobs
// =====================

model Job {
  id              String        @id @default(cuid())
  title           String
  employer        String
  location        String
  vertical        String
  description     String        @db.Text
  // Nullable: a posting may state no wage. Must render as "Pay not
  // specified" rather than an invented figure. Kept in sync with the
  // Skilmatch schema — both apps share this database.
  payMin          Int?          // hourly cents
  payMax          Int?          // hourly cents
  payType         String        // "hourly" | "salary" | "contract"
  shiftType       String        @default("full_time") // "full_time" | "part_time" | "contract" | "per_diem"
  isActive        Boolean       @default(true)
  isAIReplaceable Boolean       @default(false)
  recruiterEmail  String?
  closedAt        DateTime?
  closedReason    String?
  optionalSkills  String[]      @default([])
  requiredSkills  JobSkill[]
  postedAt        DateTime      @default(now())

  // ── Provenance (added 2026-11-04) ─────────────────────────────────
  // Every job must be able to say where it came from. Without this the
  // database held 1,618 model-invented listings attributed to real
  // employers, indistinguishable from real ones because nothing
  // recorded a source.
  //
  // source     — "adzuna" | "employer" | "greenhouse" | "lever" | ...
  // sourceUrl  — the original posting, where a jobseeker actually applies
  // externalId — the source's own id, so re-imports update not duplicate
  // lastSeenAt — last time the source confirmed this posting still exists
  source          String?
  sourceUrl       String?
  externalId      String?
  lastSeenAt      DateTime?

  applications    Application[]

  @@index([recruiterEmail])
  @@index([isActive])
  @@index([source, externalId])
  @@index([lastSeenAt])
}

model JobSkill {
  id               String  @id @default(cuid())
  jobId            String
  job              Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  normalizedTerm   String
  proficiencyLevel String
  isRequired       Boolean @default(true)
}

// =====================
// Upskill Resources
// =====================

model UpskillResource {
  id          String  @id @default(cuid())
  skillTerm   String
  title       String
  provider    String
  url         String
  isFree      Boolean @default(false)
  durationHrs Float?
  vertical    String?
}

// =====================
// Applications
// =====================

model Application {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String   @default("applied") // "applied" | "viewed" | "unlocked" | "hired"
  appliedAt DateTime @default(now())
}

// =====================
// Analytics Events
// =====================

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String   // "skill_added", "match_revealed", "tab_b_viewed", etc.
  userId    String?
  metadata  String?  @db.Text // JSON blob
  createdAt DateTime @default(now())

  @@index([event])
  @@index([createdAt])
}

// =====================
// Employer Charge Events
// =====================

model ChargeEvent {
  id              String   @id @default(cuid())
  type            String   // "employer_unlock" | "employer_job_post" | "training_referral"
  employerId      String?
  candidateHandle String?
  jobId           String?
  skillTerm       String?
  provider        String?
  amount          Int?     // cents
  createdAt       DateTime @default(now())

  @@index([type])
}
